{
  "handle": "brookservers",
  "stack": "store",
  "summary": "web · api · api-migrator · jobs · tools · assistant",
  "commands": [
    "git clone -b demo/brookservers-store-8b0206 https://github.com/flisk-sh/demos.git store-demo",
    "cd store-demo",
    "npm install -g @flisk-sh/flisk",
    "flisk doctor",
    "flisk up"
  ],
  "services": [
    {
      "name": "web",
      "appType": "frontend",
      "note": "react app"
    },
    {
      "name": "api",
      "appType": "backend",
      "note": "bun + hono API"
    },
    {
      "name": "api-migrator",
      "appType": "migrator",
      "note": "runs Prisma migrations against the shared Postgres before the api starts"
    },
    {
      "name": "jobs",
      "appType": "worker",
      "note": "background work: email"
    },
    {
      "name": "tools",
      "appType": "mcp",
      "note": "MCP server over Streamable HTTP at /mcp"
    },
    {
      "name": "assistant",
      "appType": "agent",
      "note": "/health, /ready, x-session-id routing, checkpoints survive restarts"
    }
  ],
  "board": {
    "noun": "products",
    "one": "product",
    "seedFile": "services/store/api/src/seed.ts",
    "hasJobs": true
  }
}
