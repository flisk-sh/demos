{
  "port": 4000,
  "dependsOn": [
    "api-migrator"
  ],
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "dev": {
    "command": "bun run dev",
    "watch": [
      "src/**/*"
    ]
  },
  "healthCheckPath": "/health",
  "$schema": "https://flisk.sh/schema.service.json",
  "schemaVersion": 1,
  "appName": "api",
  "appType": "backend",
  "featuresEnabled": [
    "prisma",
    "redis",
    "websocket"
  ],
  "name": "api",
  "type": "backend",
  "stack": "agents",
  "params": {
    "ASSISTANT_URL": "http://assistant:4100"
  }
}
