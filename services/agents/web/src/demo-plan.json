{
  "handle": "yourhandle",
  "stack": "agents",
  "summary": "web · api · tools · assistant",
  "commands": [
    "git clone -b demo/yourhandle-agents-4eaaf9 https://github.com/flisk-sh/demos.git agents-demo",
    "cd agents-demo",
    "npm install -g @flisk-sh/flisk",
    "flisk doctor",
    "flisk up"
  ],
  "services": [
    {
      "name": "web",
      "appType": "frontend",
      "note": "react app"
    },
    {
      "name": "api",
      "appType": "backend",
      "note": "bun + hono API"
    },
    {
      "name": "tools",
      "appType": "mcp",
      "note": "MCP server over Streamable HTTP at /mcp"
    },
    {
      "name": "assistant",
      "appType": "agent",
      "note": "/health, /ready, x-session-id routing, checkpoints survive restarts"
    }
  ],
  "chat": {
    "assistant": "assistant"
  }
}
