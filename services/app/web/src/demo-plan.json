{
  "handle": "flisk_sh",
  "stack": "app",
  "summary": "web · api · api-migrator · jobs",
  "commands": [
    "git clone -b demo/flisk_sh-app-0bb598 https://github.com/flisk-sh/demos.git app-demo",
    "cd app-demo",
    "npm install -g @flisk-sh/flisk",
    "flisk doctor",
    "flisk up"
  ],
  "services": [
    {
      "name": "web",
      "appType": "frontend",
      "note": "react app"
    },
    {
      "name": "api",
      "appType": "backend",
      "note": "bun + hono API"
    },
    {
      "name": "api-migrator",
      "appType": "migrator",
      "note": "runs Prisma migrations against the shared Postgres before the api starts"
    },
    {
      "name": "jobs",
      "appType": "worker",
      "note": "background work: jobs, email"
    }
  ],
  "board": {
    "noun": "tasks",
    "one": "task",
    "seedFile": "services/app/api/src/seed.ts",
    "hasJobs": true
  }
}
